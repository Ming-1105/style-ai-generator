# Copy this file to .env and fill in what you need. Never commit .env.

# 1 = every endpoint returns fixture data from /fixtures (no API keys needed)
MOCK_MODE=1

# Person A — Sourcing
IMAGE_SEARCH_PROVIDER=
IMAGE_SEARCH_API_KEY=

# Person B — AI core
VISION_PROVIDER=
VISION_API_KEY=
# Optional: which model, e.g. gemini-3.5-flash-lite (see docs/decision-log.md for what works on a free key)
VISION_MODEL=
# Optional: low, medium, high or default. Fewer tokens per image = cheaper and faster. Empty = low.
VISION_IMAGE_DETAIL=
# Optional: minimal, low, medium, high or default. How much the model thinks; thinking is billed as output. Empty = minimal.
VISION_THINKING=
# Optional spending limit in dollars, e.g. 5. Requests stop when the estimated spend in usage_ledger.jsonl reaches it.
VISION_BUDGET_USD=
